OPENAI_API_KEY=

# Project Skyline shared Supabase project (same project/keys as the other
# Skyline apps, e.g. skyline-j3-social-history / project-skyline-admin).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Domain used to build each student's synthetic auth email from their
# login_id, e.g. login_id "s001" -> s001@<this domain>.
NEXT_PUBLIC_AUTH_INTERNAL_EMAIL_DOMAIN=

# Development only. When OPENAI_API_KEY is empty and this is "true" (and
# NODE_ENV is not production) the API returns clearly-labelled demo feedback
# that does NOT complete a Day. In production, a missing key yields an
# "AI unavailable" error instead of fake feedback.
WRITING_TOWER_ALLOW_MOCK_FEEDBACK=
